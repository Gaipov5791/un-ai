# LiveKit Cloud — https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Telegram саммари — веха C/D, не веха B
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# Агент
UNAI_AGENT_NAME=un-ai-receptionist

# Кыргызский TTS — KaniTTS. Русский эти переменные не читает (Cartesia sonic-3).
# Агент: KANI_BASE_URL. Сервис apps/kani-server: модель, устройство, голос.
# Пока /health не status=ok, кыргызский ответ остаётся текстом на экране.
KANI_BASE_URL=
KANI_API_KEY=
KANI_MODEL=nineninesix/kani-tts-400m-ky
KANI_DEVICE=auto
KANI_VOICE=elina
KANI_HOST=0.0.0.0
KANI_PORT=8090
# KANI_PRELOAD=1
# KANI_READY_TIMEOUT_MS=8000
# KANI_TIMEOUT_MS=60000
